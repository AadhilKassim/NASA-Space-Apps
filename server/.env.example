## NASA and External APIs
# NASA_API_KEY is required for NeoWs endpoints (https://api.nasa.gov). You can get one at https://api.nasa.gov
# SBDB (https://ssd-api.jpl.nasa.gov/sbdb.api) does not require an API key.
NASA_API_KEY=YOUR_NASA_API_KEY

NODE_ENV=development
PORT=5000
NASA_API_KEY=YOUR_NASA_API_KEY
SENTRY_API_KEY=YOUR_SENTRY_API_KEY_IF_ANY
